{
  "name": "nexus-os",
  "version": "4.20.1",
  "description": "Nexus OS desktop application for Windows",
  "main": "main.js",
  "author": "Nexus",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nexus.os",
    "productName": "Nexus OS",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "guest-preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nexus-OS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus OS"
    }
  }
}
